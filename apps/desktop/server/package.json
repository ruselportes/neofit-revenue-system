{
  "name": "@neofit/desktop-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "src/main.ts",
  "scripts": {
    "dev": "tsx src/main.ts",
    "dev:fake-cloud": "tsx dev/fake-cloud.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "bundle": "esbuild src/main.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist/server.cjs --external:better-sqlite3 --external:bufferutil --external:utf-8-validate --log-level=warning"
  },
  "dependencies": {
    "@neofit/core": "*",
    "@supabase/supabase-js": "^2.118.0",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.7.0",
    "cors": "^2.8.5",
    "docx": "^9.15.2",
    "express": "^5.0.1",
    "jsonwebtoken": "^9.0.2",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.11",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.0",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.24.2",
    "jszip": "^3.10.2",
    "tsx": "^4.19.2"
  }
}
