{
  "expo": {
    "name": "NeoFit",
    "slug": "neofit-revenue-system",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0A0E1A",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.neofit.revenue",
      "infoPlist": {
        "NSCameraUsageDescription": "NeoFit needs camera access to capture logbook pages.",
        "NSPhotoLibraryUsageDescription": "NeoFit needs photo access to import logbook pictures.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.neofit.revenue",
      "permissions": [
        "android.permission.CAMERA"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "NeoFit needs camera access to capture logbook pages."
        }
      ],
      "expo-mlkit-ocr",
      [
        "expo-image-picker",
        {
          "photosPermission": "NeoFit needs photo access to import logbook pictures."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24
          }
        }
      ],
      "expo-sharing"
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
